@model ApplicationUser

@{
    ViewData["Title"] = "My Profile";
}

<div class="container mt-5">
    @if (TempData["StatusMesssage"] != null){
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong>Success!</strong> @TempData["StatusMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm text-center border-0 border-top border-primary border-5">
                <div class="card-body p-4">

                    @if(!string.IsNullOrEmpty(Model.ProfilePictureUrl)){
                        <img src="@Model.ProfilePictureUrl" alt="Profile Picture" class="rounded-circle mb-3" style="width: 150px; height:150px; object-fit: cover; border: 4px solid #f8f9fa;" />
                    }
                    else{
                        <div class="display-1 text-primary mb-3">👤</div>
                    }

                    <h4 class="fw-bold">@Model.FirstName @Model.LastName</h4>
                    <p class="text-muted">@Model.UserName</p>
                    <hr />
                    <p class="mb-1"><strong>Email:</strong> @Model.Email</p>

                    <form asp-action="UploadAvatar" method="post" enctype="multipart/form-data">
                        <div class="input-group input-group-sm mb-3">
                            <input type="file" name="file" class="form-control" accept="image/*" required />
                            <button class="btn btn-outline-primary" type="submit">Upload</button>
                        </div>
                    </form>
                    
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white fw-bold py-3">
                    Security Settings
                </div>
                <div class="card-body p-4 d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="fw-bold mb-1">Account Password</h5>
                        <p class="text-muted mb-0 small">It is a good idea to use a strong password that you don't use elsewhere.</p>
                    </div>
                    <a asp-action="ChangePassword" class="btn btn-primary fw-bold">Change Password</a>
                </div>
            </div>
        </div>
    </div>
</div>