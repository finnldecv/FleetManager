@model PaginatedList<Vehicle>

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="display-6 fw-bold mb-0">Fleet Inventory</h1>
            <p class="text-muted mt-1 mb-0">Manage and monitor all active vehicles</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary fw-bold px-4 shadow-sm">
                + Register New Vehicle
            </a>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="py-3 px-4 border-bottom-0">Make & Model</th>
                        <th class="py-3 px-4 border-bottom-0">VIN</th>
                        <th class="py-3 px-4 border-bottom-0">Current Mileage</th>
                        <th class="py-3 px-4 border-bottom-0">Assigned Mechanic</th>
                        <th class="py-3 px-4 border-bottom-0 text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var car in Model)
                        {
                            <tr>
                                <td class="py-3 px-4 fw-bold text-dark">
                                    @car.Make @car.Model
                                    @if (car.NeedsMaintenance)
                                    {
                                        <br />
                                        <span class="badge bg-warning text-dark mt-1 shadow-sm"
                                              title="Over 5,000 mileage since last maintenance">
                                            ⚠️ Service Due
                                        </span>
                                    }
                                </td>
                                <td class="py-3 px-4 text-muted text-monospace text-uppercase">
                                    @car.VIN
                                </td>
                                <td class="py-3 px-4 text-success fw-semibold">
                                    @car.CurrentMileage.ToString("N0") km
                                </td>
                                <td class="py-3 px-4">
                                    @if (car.Mechanic != null)
                                    {
                                        <span class="badge bg-primary">@car.Mechanic.FirstName @car.Mechanic.LastName</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Unassigned</span>
                                    }
                                </td>
                                <td class="py-3 px-4 text-end">
                                    <div class="btn-group" role="group">
                                        <a asp-action="Details" asp-route-id="@car.Id"
                                           class="btn btn-sm btn-outline-info fw-bold">View</a>

                                        <a asp-action="Edit" asp-route-id="@car.Id"
                                           class="btn btn-sm btn-outline-secondary">Edit</a>
                                        <a asp-action="Delete" asp-route-id="@car.Id"
                                           class="btn btn-sm btn-outline-danger">Delete</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="p-5 text-center text-muted">
                                <em>No vehicles found. Click "Register New Vehicle" to get started.</em>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    
    <div class="d-flex justify-content-between align-items-center mt-4">
        <div class="text-muted small">
            Page @Model.PageIndex of @Model.TotalPages
        </div>

        <div class="btn-group shadow-sm">
            <a asp-action="Index" asp-route-pageNumber="@(Model.PageIndex - 1)"
               asp-route-searchString="@ViewData["CurrentFilter"]"
               class="btn btn-outline-primary @(!Model.HasPreviousPage ? "disabled" : "")">
                ← Previous
            </a>

            <a asp-action="Index" asp-route-pageNumber="@(Model.PageIndex + 1)"
               asp-route-searchString="@ViewData["CurrentFilter"]"
               class="btn btn-outline-primary @(!Model.HasNextPage ? "disabled" : "")">
                Next →
            </a>
        </div>
    </div>
</div>