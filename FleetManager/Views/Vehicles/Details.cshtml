@model Vehicle

<div class="container mt-5">
    
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="display-5 fw-bold mb-0">@Model.Make @Model.Model</h1>
            <p class="text-muted text-monospace mt-1 mb-0">VIN: @Model.VIN</p>
        </div>
        <div class="text-end">
            <p class="text-uppercase text-muted small fw-bold mb-0">Current Mileage</p>
            <p class="h2 fw-bold text-success mb-0">@Model.CurrentMileage.ToString("N0") km</p>
        </div>
    </div>

    <hr class="mb-5" />

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white d-flex justify-content-between align-items-center py-3 border-bottom">
            <h2 class="h5 mb-0 fw-bold text-dark">Maintenance History</h2>
            <a asp-controller="Records" asp-action="Create" asp-route-vehicleId="@Model.Id" 
               class="btn btn-primary btn-sm fw-bold">
                + Add Log
            </a>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="py-3 px-4 border-bottom-0">Date</th>
                        <th class="py-3 px-4 border-bottom-0">Description</th>
                        <th class="py-3 px-4 border-bottom-0">Mileage at Service</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.ServiceRecords.Any())
                    {
                        // Sort by newest first
                        @foreach (var record in Model.ServiceRecords.OrderByDescending(r => r.ServiceDate))
                        {
                            <tr>
                                <td class="py-3 px-4 text-secondary">@record.ServiceDate.ToString("MMM dd, yyyy")</td>
                                <td class="py-3 px-4 fw-semibold text-dark">@record.Description</td>
                                <td class="py-3 px-4 text-muted text-monospace">@record.MileageAtService.ToString("N0")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="p-5 text-center text-muted">
                                <em>No service records found for this vehicle.</em>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-4">
        <a asp-action="Index" class="text-decoration-none">
            &larr; Back to Fleet Inventory
        </a>
    </div>
</div>