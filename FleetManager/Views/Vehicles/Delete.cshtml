@model Vehicle

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            
            <div class="card shadow border-danger">
                <div class="card-header bg-danger text-white py-3">
                    <h2 class="h5 mb-0 fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i> Confirm Deletion</h2>
                </div>
                
                <div class="card-body p-4 bg-light">
                    <h4 class="text-dark fw-bold mb-3">Are you sure you want to delete this vehicle?</h4>
                    <p class="text-muted mb-4">This will remove the vehicle from the active fleet inventory. Because of our strict auditing rules, the database records will be retained (Soft Delete), but it will no longer be accessible through this dashboard.</p>

                    <div class="bg-white p-3 rounded border mb-4">
                        <div class="row mb-2">
                            <div class="col-sm-4 text-muted fw-bold">Make & Model:</div>
                            <div class="col-sm-8 fw-semibold">@Model.Make @Model.Model</div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-sm-4 text-muted fw-bold">VIN:</div>
                            <div class="col-sm-8 text-monospace">@Model.VIN</div>
                        </div>
                        <div class="row">
                            <div class="col-sm-4 text-muted fw-bold">Mileage:</div>
                            <div class="col-sm-8">@Model.CurrentMileage.ToString("N0") km</div>
                        </div>
                    </div>

                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />
                        
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <a asp-action="Index" class="btn btn-outline-secondary fw-bold px-4">Cancel</a>
                            <button type="submit" class="btn btn-danger fw-bold px-4">Yes, Delete Vehicle</button>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>