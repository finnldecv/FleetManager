@model string

@{
    ViewData["Title"] = "Create Role";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6">
        <div class="card shadow-sm border-0 border-top border-primary border-5">
            <div class="card-body p-5">
                <h3 class="fw-bold mb-4">Create New Role</h3>
                
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>
                    
                    <div class="form-floating mb-4">
                        <input type="text" name="roleName" class="form-control" placeholder="Role Name" required />
                        <label for="roleName">Role Name (e.g., Supervisor)</label>
                    </div>
                    
                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary fw-bold">Cancel</a>
                        <button type="submit" class="btn btn-primary fw-bold">Create Role</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>