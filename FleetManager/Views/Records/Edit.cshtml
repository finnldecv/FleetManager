@model ServiceRecord

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <div class="card shadow border-secondary border-top border-4">
                <div class="card-header bg-white py-3">
                    <h2 class="h5 mb-0 fw-bold text-dark">Edit Maintenance Log</h2>
                    <p class="text-muted small mb-0 mt-1">Vehicle: <span class="fw-bold">@ViewBag.VehicleName</span></p>
                </div>

                <div class="card-body p-4 bg-light">
                    <form asp-action="Edit" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="VehicleId" />

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="ServiceDate" class="form-label fw-bold text-secondary">Date of
                                    Service</label>
                                    <input asp-for="ServiceDate" type="date" class="form-control" required />
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="MileageAtService" class="form-label fw-bold text-secondary">Mileage at
                                        Service</label>
                                        <input asp-for="MileageAtService" type="number" class="form-control" required />
                                    </div>
                                </div>

                                <div class="mb-4">
                                    <label asp-for="Description" class="form-label fw-bold text-secondary">Service
                                        Description</label>
                                        <textarea asp-for="Description" class="form-control" rows="4" required></textarea>
                                    </div>

                                    <div class="d-flex justify-content-between align-items-center mt-2">
                                        <a asp-action="Index" class="btn btn-outline-secondary fw-bold px-4">Cancel</a>
                                        <button type="submit" class="btn btn-success fw-bold px-4">Save Changes</button>
                                    </div>

                                </form>
                            </div>
                        </div>

                    </div>
                </div>
            </div>