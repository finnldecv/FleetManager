@model IEnumerable<ServiceRecord>

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="display-6 fw-bold mb-0"><i class="bi bi-clipboard-data me-2"></i> Global Maintenance Log</h1>
            <p class="text-muted mt-1 mb-0">Company-wide view of all recent vehicle repairs and services</p>
        </div>
    </div>

    <div class="card shadow-sm border-0 border-top border-primary border-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="py-3 px-4 border-bottom-0">Date</th>
                        <th class="py-3 px-4 border-bottom-0">Vehicle</th>
                        <th class="py-3 px-4 border-bottom-0">Mileage</th>
                        <th class="py-3 px-4 border-bottom-0">Description</th>
                        <th class="py-3 px-4 border-bottom-0 text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var record in Model)
                        {
                            <tr>
                                <td class="py-3 px-4 fw-semibold text-dark">
                                    @record.ServiceDate.ToString("MMM dd, yyyy")
                                </td>
                                <td class="py-3 px-4">
                                    <a asp-controller="Vehicles" asp-action="Details" asp-route-id="@record.VehicleId"
                                       class="text-decoration-none fw-bold">
                                        @record.Vehicle?.Make @record.Vehicle?.Model
                                    </a>
                                </td>
                                <td class="py-3 px-4 text-muted text-monospace">
                                    @record.MileageAtService.ToString("N0") km
                                </td>
                                <td class="py-3 px-4 text-secondary">
                                    <span class="badge bg-secondary me-2">@record.Category</span>
                                    <span class="fw-bold">@record.Description</span>

                                    @if (!string.IsNullOrEmpty(record.ReceiptUrl))
                                    {
                                        <br />
                                        <a href="@record.ReceiptUrl" target="_blank"
                                           class="badge bg-light text-primary border border-primary text-decoration-none mt-1">
                                            📎 View Receipt
                                        </a>
                                    }
                                </td>
                                <td class="py-3 px-4 text-end">
                                    <div class="btn-group" role="group">
                                        <a asp-action="Edit" asp-route-id="@record.Id"
                                           class="btn btn-sm btn-outline-secondary">Edit</a>
                                        <a asp-action="Delete" asp-route-id="@record.Id"
                                           class="btn btn-sm btn-outline-danger">Delete</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="p-5 text-center text-muted">
                                <em>No maintenance records found in the system.</em>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>