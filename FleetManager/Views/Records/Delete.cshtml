@model ServiceRecord

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            
            <div class="card shadow border-danger">
                <div class="card-header bg-danger text-white py-3">
                    <h2 class="h5 mb-0 fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i> Confirm Log Deletion</h2>
                </div>
                
                <div class="card-body p-4 bg-light">
                    <h4 class="text-dark fw-bold mb-3">Delete this maintenance record?</h4>
                    <p class="text-muted mb-4">This action will soft-delete the service record for auditing purposes. It will no longer appear on the dashboard or the vehicle's history.</p>

                    <div class="bg-white p-3 rounded border mb-4">
                        <div class="row mb-2">
                            <div class="col-sm-4 text-muted fw-bold">Vehicle:</div>
                            <div class="col-sm-8 fw-semibold">@Model.Vehicle?.Make @Model.Vehicle?.Model</div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-sm-4 text-muted fw-bold">Date:</div>
                            <div class="col-sm-8">@Model.ServiceDate.ToString("MMM dd, yyyy")</div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-sm-4 text-muted fw-bold">Mileage:</div>
                            <div class="col-sm-8">@Model.MileageAtService.ToString("N0") km</div>
                        </div>
                        <div class="row">
                            <div class="col-sm-4 text-muted fw-bold">Details:</div>
                            <div class="col-sm-8 text-secondary">@Model.Description</div>
                        </div>
                    </div>

                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />
                        
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <a asp-action="Index" class="btn btn-outline-secondary fw-bold px-4">Cancel</a>
                            <button type="submit" class="btn btn-danger fw-bold px-4">Yes, Delete Log</button>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>