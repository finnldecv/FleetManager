@model ServiceRecord

@{
    ViewData["Title"] = "Log Service";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6">
        <div class="card shadow-sm border-0 border-top border-success border-5">
            <div class="card-body p-4">
                <h3 class="fw-bold mb-4">⚙️ Log Vehicle Service</h3>

                <form asp-action="Create" method="post">
                    <input type="hidden" asp-for="VehicleId" />

                    <div asp-validation-summary="All" class="text-danger mb-3 small"></div>

                    <div class="form-floating mb-3">
                        <select asp-for="Category" class="form-select" asp-items="Html.GetEnumSelectList<ServiceCategory>()">
                            <option value="">-- Select Service Type --</option>
                        </select>
                        <label asp-for="Category"></label>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="ServiceDate" class="form-control" type="date" />
                                <label asp-for="ServiceDate"></label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="MileageAtService" class="form-control" type="number" />
                                <label asp-for="MileageAtService"></label>
                            </div>
                        </div>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Cost" class="form-control" type="number" step="0.01" placeholder="0.00" />
                        <label asp-for="Cost">Total Cost ($)</label>
                    </div>

                    <div class="form-floating mb-4">
                        <textarea asp-for="Description" class="form-control" style="height: 100px" placeholder="Describe the work done..."></textarea>
                        <label asp-for="Description"></label>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-controller="Vehicles" asp-action="Details" asp-route-id="@Model.VehicleId" class="btn btn-outline-secondary fw-bold">Cancel</a>
                        <button type="submit" class="btn btn-success fw-bold px-4">Save Record</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>