@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    <span class="text-dark me-3 small">Hello, @UserManager.GetUserAsync(User).Result?.FirstName!</span>
    <form class="d-inline me-3" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
        <button type="submit" class="btn btn-sm btn-outline-danger border-0 fw-bold">Logout</button>
    </form>
}
else
{
    <a class="btn btn-sm btn-outline-light text-dark me-2 border-0" asp-area="Identity" asp-page="/Account/Register">Register</a>
    <a class="btn btn-sm btn-light text-dark me-3 fw-bold" asp-area="Identity" asp-page="/Account/Login">Login</a>
}