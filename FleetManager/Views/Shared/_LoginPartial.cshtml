@using Microsoft.AspNetCore.Identity
@using FleetManager.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    var user = await UserManager.GetUserAsync(User);
}

@if (SignInManager.IsSignedIn(User))
{
    @if (user != null && !string.IsNullOrEmpty(user.ProfilePictureUrl))
    {
        <img src="@user.ProfilePictureUrl" class="rounded-circle me-2" style="width: 30px; height: 30px; object-fit: cover;" />
    }
    <a class="nav-link text-dark" asp-controller="Profile" asp-action="Index" title="Manage">
        Hello, @((user?.FirstName == string.Empty) ? User.Identity?.Name :
                                    user?.FirstName)
    </a>

    <form class="d-inline me-3" asp-controller="Account" asp-action="Logout" method="post">
        <button type="submit" class="btn btn-sm btn-outline-danger border-0 fw-bold">Logout</button>
    </form>
}
else
{
    <a class="btn btn-sm btn-light text-dark me-2 border-0" asp-controller="Account" asp-action="Register">Register</a>
    <a class="btn btn-sm btn-light text-dark me-3 fw-bold" asp-controller="Account" asp-action="Login">Login</a>
}