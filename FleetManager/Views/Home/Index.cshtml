@model DashboardViewModel

@{
    ViewData["Title"] = "Executive Dashboard";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="display-5 fw-bold mb-0">Fleet Overview</h1>
            <p class="text-muted mt-1">Real-time telemetry and maintenance tracking</p>
        </div>
    </div>

    <div class="row mb-4">

        <div class="col-md-2">
            <div class="card shadow-sm border-0 border-start border-primary border-5 h-100">
                <div class="card-body p-4">
                    <h6 class="text-muted text-uppercase fw-bold mb-2">Active Vehicles</h6>
                    <h2 class="display-4 fw-bold text-dark mb-0">@Model.TotalVehicles</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 border-start border-success border-5 h-100">
                <div class="card-body p-4">
                    <h6 class="text-muted text-uppercase fw-bold mb-2">Total Fleet Mileage</h6>
                    <h2 class="display-4 fw-bold text-dark mb-0">@Model.TotalFleetMileage.ToString("N0") <span
                        class="fs-4 text-muted">km</span></h2>
                    </div>
                </div>
            </div>

            <div class="col-md-2">
                <div class="card shadow-sm border-0 border-start border-info border-5 h-100">
                    <div class="card-body p-4">
                        <h6 class="text-muted text-uppercase fw-bold mb-2">Logs</h6>
                        <h2 class="display-4 fw-bold text-dark mb-0">@Model.TotalMaintenanceLogs</h2>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card shadow-sm border-0 border-start border-danger border-5 h-100">
                    <div class="card-body p-3">
                        <h6 class="text-muted text-uppercase fw-bold mb-2">Total Expenses</h6>
                        <h3 class="display-4 fw-bold mb-0 text-danger">@Model.TotalMaintenanceCost.ToString("C0")</h3>
                    </div>
                </div>
            </div>

            <div class="col-md-2">
                <div class="card shadow-sm border-0 border-start border-warning border-5 h-100">
                    <div class="card-body p-3">
                        <h6 class="text-muted text-uppercase fw-bold mb-2">Needs Service</h6>
                        <h3 class="display-4 fw-bold mb-0 text-warning">@Model.VehiclesNeedingService</h3>
                    </div>
                </div>
            </div>
        </div>

    
        <div class="row">

            <div class="col-md-5 mb-4">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white fw-bold py-3">Fleet Health Status</div>
                    <div class="card-body">
                        <canvas id="healthChart" height="250"></canvas>
                    </div>
                </div>
            </div>
            <div class="col-md-7 mb-4">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                        <h5 class="mb-0 fw-bold"><i class="bi bi-clock-history me-2 text-primary"></i>Recent Maintenance
                            Activity</h5>
                            <a asp-controller="Records" asp-action="Index" class="btn btn-sm btn-outline-primary">View All
                                Logs</a>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="py-3 px-4">Date</th>
                                            <th class="py-3 px-4">Vehicle</th>
                                            <th class="py-3 px-4">Service</th>
                                            <th class="text-end py-3 px-4">Cost</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model.RecentServices != null && Model.RecentServices.Any())
                                        {
                                            @foreach (var record in Model.RecentServices)
                                            {
                                                <tr>
                                                    <td class="py-3 px-4 fw-semibold text-dark">
                                                        @record.ServiceDate.ToString("MMM dd, yyyy")
                                                    </td>
                                                    <td class="py-3 px-4">
                                                        <a asp-controller="Vehicles" asp-action="Details" asp-route-id="@record.VehicleId"
                                                           class="text-decoration-none fw-bold">
                                                            @record.Vehicle?.Make @record.Vehicle?.Model
                                                        </a>
                                                    </td>
                                                    <td class="py-3 px-4 text-secondary">
                                                        @record.Description
                                                    </td>
                                                    <td class="text-end py-3 px-4 fw-semibold">@record.Cost.ToString("C0")</td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="4" class="p-5 text-center text-muted">
                                                    <em>No recent services.</em>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            @section Scripts {
                <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
                <script>
                    const ctx = document.getElementById('healthChart').getContext('2d');
                    new Chart(ctx, {
                        type: 'doughnut',
                        data: {
                        labels: ['Healthy Vehicles', 'Service Required'],
                        datasets: [{
                        data: [@Model.HealthyVehiclesCount, @Model.VehiclesNeedingService],
                        backgroundColor: ['#198754', '#ffc107'],
                        borderWidth: 0,
                        hoverOffset: 4
                        }]
                        },
                        options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                        legend: { position: 'bottom' }
                        }
                        }
                    });
                </script>
            }

       