@model List<ManageUserRolesViewModel>

@{
    var userId = ViewBag.userId;
    ViewData["Title"] = "Manage Roles";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6">
        <div class="card shadow-sm border-0 border-top border-primary border-5">
            <div class="card-body p-4">Manage Roles</div>
            <p class="text-muted mb-4">Editing clearances for:
                <span class="fw-bold text-dark">@ViewBag.UserName</span>
            </p>
            <form method="post">
                <div class="mb-4">
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        <div class="form-check m-1">
                            <input type="hidden" asp-for="@Model[i].RoleId" />
                            <input type="hidden" asp-for="@Model[i].RoleName" />

                            <input asp-for="@Model[i].IsSelected" class="form-check-input" />
                            <label class="form-check-label fw-bold" asp-for="@Model[i].IsSelected">
                                @Model[i].RoleName
                            </label>
                        </div>
                    }
                    <div asp-validation-summary="All" class="text-danger mt-2"></div>
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary fw-bold">Cancel</a>
                    <button type="submit" class="btn btn-primary fw-bold" style="width:auto">Update Roles</button>
                </div>
            </form>
        </div>
    </div>
</div>