@model IEnumerable<ApplicationUser>
@{
    ViewData["Title"] = "Employee Directory";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">Employee Directory</h2>
        <span class="badge bg-primary fs-6">Total Staff: @Model.Count()</span>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table class="table table-hover table-stripped mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>First Name</th>
                        <th>Last Name</th>
                        <th>Username</th>
                        <th>Email</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td class="align-middle">@user.FirstName</td>
                            <td class="align-middle">@user.LastName</td>
                            <td class="align-middle">
                                <span class="badge bg-secondary">@user.UserName</span>
                            </td>
                            <td class="align-middle">@user.Email</td>
                            <td class="align-middle">
                                @if (user.LockoutEnd != null && user.LockoutEnd > DateTimeOffset.UtcNow)
                                {
                                    <span class="badge bg-danger">Locked</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-2">
                                    <a asp-controller="Admin" asp-action="ManageRoles" asp-route-userId="@user.Id"
                                       class="btn btn-sm btn-outline-primary fw-bold">
                                        Manage Roles
                                    </a>
                                    <a asp-controller="Admin" asp-action="ResetPassword" asp-route-userId="@user.Id"
                                       class="btn btn-sm btn-outline-warning fw-bold">
                                        Reset Password
                                    </a>
                                    @if (user.UserName != User.Identity?.Name)
                                    {
                                        <form asp-action="ToggleLock" method="post">
                                            <input type="hidden" name="userId" value="@user.Id" />
                                            @if (user.LockoutEnd != null && user.LockoutEnd > DateTimeOffset.UtcNow)
                                            {
                                                <button type="submit" class="btn btn-sm btn-success fw-bold">Unlock</button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-sm btn-danger fw-bold">Lock Account</button>
                                            }
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>